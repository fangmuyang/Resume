{
  "name": "resume-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "个人网站项目根：Git 规范与提交钩子（业务工程在 site/）",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --dir site run dev",
    "build": "pnpm --dir site run build",
    "preview": "pnpm --dir site run preview",
    "lint": "pnpm --dir site run lint",
    "typecheck": "pnpm --dir site run typecheck",
    "format": "pnpm --dir site run format",
    "test": "pnpm --dir site run test",
    "test:coverage": "pnpm --dir site run test:coverage",
    "test:e2e": "pnpm --dir site run test:e2e",
    "extract": "pnpm --dir site run extract",
    "build:posts-index": "pnpm --dir site run build:posts-index",
    "build:content": "pnpm --dir site run build:content",
    "validate": "pnpm --dir site run validate",
    "check": "pnpm --dir site run check",
    "verify:build": "pnpm --dir site run verify:build",
    "verify:content": "pnpm --dir site run verify:content",
    "verify:privacy": "pnpm --dir site run verify:privacy",
    "verify:search": "pnpm --dir site run verify:search",
    "verify:seo": "pnpm --dir site run verify:seo",
    "verify:workflows": "pnpm --dir site run verify:workflows"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0"
  }
}
