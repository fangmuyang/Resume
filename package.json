{
  "name": "resume-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "个人网站项目根：Git 规范与提交钩子（业务工程在 site/）",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --dir site run dev",
    "build": "pnpm --dir site run build",
    "lint": "pnpm --dir site run lint",
    "typecheck": "pnpm --dir site run typecheck",
    "format": "pnpm --dir site run format",
    "extract": "pnpm --dir site run extract",
    "validate": "pnpm --dir site run validate",
    "check": "pnpm --dir site run check",
    "verify:build": "pnpm --dir site run verify:build",
    "verify:content": "pnpm --dir site run verify:content"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0"
  }
}
