{
  "name": "resume-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "方睿杰的个人网站：React 19 + TypeScript + Vite 学习项目",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build-posts-index.ts && tsx scripts/build-public-content.ts && tsx scripts/validate-content.ts && tsc --noEmit && vite build && tsx scripts/build-prerender.ts && tsx scripts/build-seo.ts && tsx scripts/verify-build.ts && tsx scripts/verify-privacy.ts && tsx scripts/verify-seo.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "verify:content": "tsx scripts/verify-content-usage.ts",
    "verify:privacy": "tsx scripts/verify-privacy.ts",
    "verify:search": "tsx scripts/verify-search-index.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "build:seo": "tsx scripts/build-seo.ts",
    "build:prerender": "tsx scripts/build-prerender.ts",
    "icons": "tsx scripts/build-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "check:full": "npm run check && npm run test:e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "tsx scripts/extract-pdf.ts",
    "build:posts-index": "tsx scripts/build-posts-index.ts",
    "build:content": "tsx scripts/extract-pdf.ts && tsx scripts/build-posts-index.ts && tsx scripts/build-public-content.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check": "tsx scripts/validate-content.ts && tsx scripts/verify-content-usage.ts && tsx scripts/verify-search-index.ts && tsc --noEmit && eslint . --max-warnings 0 && prettier --check . && vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuse.js": "7.5.0",
    "lucide-react": "1.54.0",
    "motion": "14.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.104.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype-pretty-code": "0.14.5",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7",
    "zod": "4.6.5"
  }
}
