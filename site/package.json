{
  "name": "resume-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "方睿杰的个人网站：React 19 + TypeScript + Vite 学习项目",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/validate-content.ts && tsc --noEmit && vite build && tsx scripts/verify-build.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "tsx scripts/extract-pdf.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check": "tsx scripts/validate-content.ts && tsc --noEmit && eslint . --max-warnings 0 && prettier --check ."
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "zod": "4.6.5"
  }
}
