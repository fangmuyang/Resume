# ---- pnpm settings (.npmrc) ----
# NOTE: keep this file ASCII-only. Node on Windows decodes BOM-less files using
# the system ANSI codepage, so non-ASCII comments here get mangled and can
# swallow the settings that follow them.

# Flat npm-style node_modules layout.
# pnpm's default "isolated" layout links packages through junctions under
# node_modules/.pnpm. Keep this line unless you have verified that ESM
# resolution works in your environment.
node-linker=hoisted

# Do not let peer-dependency warnings block installation.
# This also hides real version conflicts, so production projects should
# leave it at the default (true) instead.
strict-peer-dependencies=false
