{
  "compilerOptions": {
    /* ---- language & runtime ---- */
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"],

    /* ---- type strictness: the core value of this learning project ---- */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    /* ---- module interop ---- */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* ---- type check only; Vite produces the build output ---- */
    "noEmit": true,

    /* ---- path alias (keep in sync with resolve.alias in vite.config.ts) ---- */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /**
   * e2e/ 由 Playwright 自己转译与执行，不参与生产的类型检查：
   * 它依赖 @playwright/test 的类型，而那份依赖只在本地装了浏览器后才可用。
   * 放进 include 会让 `pnpm typecheck` 在没有 Playwright 的环境下直接失败。
   */
  "include": ["src", "vite.config.ts", "vitest.config.ts", "scripts"],
  "exclude": ["e2e"]
}
